# Copy to .env for local runs. In GitHub Actions, set these as repository secrets instead
# (Settings -> Secrets and variables -> Actions) using the same names.

# --- QuickBooks Online ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
# "sandbox" while testing, "production" when live
QBO_ENVIRONMENT=sandbox

# --- ServiceM8 ---
# ServiceM8 -> Setup -> API Access Keys
SM8_API_KEY=

# --- Outlook / Microsoft 365 (Microsoft Graph) ---
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REFRESH_TOKEN=
